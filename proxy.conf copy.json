{
  "/api": {
    "target": "https://includepages.lpu.in",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/header": "/newlpu/header.php",
      "^/api/footer": "/newlpu/footer.php"
    }
  }
}

